/android/app/release

# Widget Preview related
.widget_preview/

# The tools under testing-tools/ are run by hand and are not part of the app.
# What they produce while they are being used is not published with the sources:
# the test photo hoster stores the images it is given, stash-db-import records
# the responses it is asked for, and the PornoLab stub keeps the .torrent files
# the forms it is given. The data a test reads is committed under
# test/fixtures/, not here.
testing-tools/test-hoster/photos/
testing-tools/stash-db-import/captured/
testing-tools/pornolab-stub/posted/

# The toolchain installed on this machine is recorded separately, and that file
# is not published with the sources, so it is not tracked.
ai/environment.md

# Bundled native tools. The binaries under native/ are the build inputs and are
# committed. A working copy is made at the top of native/uptooda/ so the tool
# can be run from the repo, because it looks for Data/ in its own directory.
native/uptooda/uptooda-cli
native/uptooda/uptooda-cli.exe

# Scratch files, such as the run logs downloaded from GitHub Actions.
temp/

AGENTS.md